{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.nvc360.uberize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101827"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://arriveping.com",
      "applicationId": "nvc360-bgyv8cj",
      "eas": {
        "projectId": "6e43daa9-bb98-41e0-b7b7-9ea0e7a9ebac"
      }
    },
    "ios": {
      "bundleIdentifier": "com.nvc360.uberize",
      "appleTeamId": "86S82A9ZPS",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ArrivePing shares your live location with dispatch while you are on shift so customers can be given accurate ETAs.",
        "NSLocationWhenInUseUsageDescription": "ArrivePing shares your live location during active jobs.",
        "NSMicrophoneUsageDescription": "ArrivePing records short voice notes so you can dictate job details to the office instead of typing on site.",
        "NSFaceIDUsageDescription": "ArrivePing uses Face ID to quickly and securely unlock the app.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "requireFullScreen": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b12"
    },
    "name": "ArrivePing",
    "slug": "nvc360v4",
    "owner": "nvc360",
    "version": "1.0.4",
    "scheme": [
      "arriveping",
      "homeserve"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#070b12"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ArrivePing to share your live location with dispatch while you are on shift.",
          "locationWhenInUsePermission": "Allow ArrivePing to share your live location during active jobs.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0ea5e9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ArrivePing to access your photos to upload job and profile images.",
          "cameraPermission": "Allow ArrivePing to use the camera to capture job photos."
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "ArrivePing adds the jobs you're assigned to your calendar and keeps their times and addresses up to date.",
          "remindersPermission": false
        }
      ],
      [
        "expo-live-activity",
        {
          "enablePushNotifications": true
        }
      ],
      "@sentry/react-native",
      "expo-audio"
    ],
    "runtimeVersion": "1.0.4",
    "updates": {
      "url": "https://u.expo.dev/6e43daa9-bb98-41e0-b7b7-9ea0e7a9ebac"
    }
  }
}
